import { Button, LineEdit, TextEdit, ComboBox, ListView, CheckBox, Palette } from "std-widgets.slint";

// One rendered line in the chat transcript.
export struct ChatLine {
    sender: string,
    text: string,
    time: string,
}

// Localized static UI labels, filled from Rust (Fluent).
export struct Strings {
    login-as: string,
    password: string,
    log-in: string,
    back: string,
    select-user: string,
    create-new-user: string,
    username: string,
    create-user: string,
    log-out: string,
    session: string,
    new-session: string,
    wizard-title: string,
    session-name: string,
    inbound: string,
    gen-keys: string,
    my-keys-label: string,
    peer-keys-label: string,
    first-msg-label: string,
    create-session: string,
    close: string,
    init-msg-label: string,
    history: string,
    message-placeholder: string,
    encrypt: string,
    decrypt: string,
    paste: string,
    outgoing-label: string,
    copy: string,
}

// Status / error line: red on error, gray otherwise.
component StatusLine inherits Text {
    in property <string> message;
    in property <bool> is-error;
    text: message;
    color: is-error ? #e0554f : gray;
    wrap: word-wrap;
}

export component MainWindow inherits Window {
    title: "OpenE2E";
    icon: @image-url("../../../doc/img/logo.png");
    background: Palette.background;
    preferred-width: 460px;
    preferred-height: 760px;
    min-width: 360px;
    min-height: 520px;

    // State, driven from Rust
    in-out property <bool> logged-in: false;
    in-out property <[string]> users;
    in-out property <string> login-user;
    in-out property <string> confirm-delete-user;  // user whose delete is armed
    in-out property <string> current-user;
    in-out property <string> current-session;
    in-out property <[string]> sessions;
    in-out property <[ChatLine]> messages;
    in-out property <int> message-count;
    in-out property <string> message-input;
    in-out property <string> output-text;
    in-out property <string> status-text;
    in-out property <bool> status-is-error;

    // Localization
    in property <Strings> t;
    in-out property <string> language;  // current locale code ("en" / "ru")

    // Session-creation wizard state
    in-out property <bool> creating-session: false;
    in-out property <string> new-session-name;
    in-out property <string> peer-keys-input;
    in-out property <string> first-msg-input;
    in-out property <string> my-keys;
    in-out property <string> init-message;

    // Callbacks into the Rust backend
    callback login(string, string);
    callback create-user(string, string);
    callback delete-user(string);
    callback logout();
    callback select-session(string);
    callback do-encrypt(string);
    callback do-decrypt(string);
    callback submit-input(string);
    callback delete-session(string);
    callback copy-output();
    callback paste-input();
    callback session-gen-keys();
    callback session-create(string, bool, string, string);
    callback toggle-language();

    VerticalLayout {
        padding: 12px;
        spacing: 8px;

        // Login view
        if !root.logged-in: VerticalLayout {
            spacing: 4px;

            // Header (stays at top)
            HorizontalLayout {
                Rectangle { }
                Button {
                    text: root.language == "en" ? "RU" : "EN";
                    width: 60px;
                    clicked => {
                        root.toggle-language();
                    }
                }
            }
            Text {
                text: "OpenE2E";
                font-size: 22px;
                horizontal-alignment: center;
            }

            // Scrollable content area
            VerticalLayout {
                spacing: 4px;
                alignment: center;
                vertical-stretch: 0;

                // Password prompt for the selected user
                if root.login-user != "": VerticalLayout {
                    spacing: 8px;
                    alignment: center;
                    max-width: 400px;

                    Text {
                        text: root.t.login-as + " " + root.login-user;
                        horizontal-alignment: center;
                    }
                    loginpass := LineEdit {
                        placeholder-text: root.t.password;
                        input-type: InputType.password;
                        accepted => {
                            root.login(root.login-user, self.text);
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Button {
                            text: root.t.log-in;
                            enabled: loginpass.text != "";
                            clicked => {
                                root.login(root.login-user, loginpass.text);
                            }
                        }
                        Button {
                            text: root.t.back;
                            clicked => {
                                root.login-user = "";
                            }
                        }
                    }
                }

                // User list + create form
                if root.login-user == "": VerticalLayout {
                    spacing: 4px;
                    alignment: center;
                    max-width: 400px;

                    Text {
                        text: root.t.select-user;
                        color: gray;
                    }
                    for user in root.users: HorizontalLayout {
                        spacing: 8px;
                        Button {
                            text: user;
                            clicked => {
                                root.confirm-delete-user = "";
                                root.status-text = "";
                                root.login-user = user;
                            }
                        }
                        Button {
                            width: 64px;
                            text: root.confirm-delete-user == user ? "Confirm" : "Delete";
                            clicked => {
                                if (root.confirm-delete-user == user) {
                                    root.delete-user(user);
                                    root.confirm-delete-user = "";
                                } else {
                                    root.confirm-delete-user = user;
                                }
                            }
                        }
                    }

                    Rectangle {
                        height: 8px;
                    }

                    Text {
                        text: root.t.create-new-user;
                        color: gray;
                    }
                    newname := LineEdit {
                        placeholder-text: root.t.username;
                    }
                    newpass := LineEdit {
                        placeholder-text: root.t.password;
                        input-type: InputType.password;
                    }
                    Button {
                        text: root.t.create-user;
                        enabled: newname.text != "" && newpass.text != "";
                        clicked => {
                            root.create-user(newname.text, newpass.text);
                        }
                    }
                }
            }

            // Status right under the content, then the filler pushes it up.
            StatusLine {
                message: root.status-text;
                is-error: root.status-is-error;
            }
            Rectangle {
                vertical-stretch: 1;
            }
        }

        // Chat view
        if root.logged-in: VerticalLayout {
            spacing: 8px;

            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "👤 " + root.current-user;
                    vertical-alignment: center;
                }
                Rectangle { }
                Button {
                    text: root.language == "en" ? "RU" : "EN";
                    clicked => {
                        root.toggle-language();
                    }
                }
                Button {
                    text: root.t.log-out;
                    clicked => {
                        root.logout();
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: root.t.session;
                    vertical-alignment: center;
                }
                ComboBox {
                    model: root.sessions;
                    current-value: root.current-session;
                    selected(value) => {
                        root.select-session(value);
                    }
                }
                Button {
                    text: root.t.new-session;
                    clicked => {
                        root.new-session-name = "";
                        root.peer-keys-input = "";
                        root.first-msg-input = "";
                        root.my-keys = "";
                        root.init-message = "";
                        root.creating-session = true;
                    }
                }
                Button {
                    text: "Delete";
                    enabled: root.current-session != "";
                    clicked => {
                        root.delete-session(root.current-session);
                    }
                }
            }

            //------ Session-creation wizard------
            if root.creating-session: VerticalLayout {
                spacing: 6px;

                Text {
                    text: root.t.wizard-title;
                    font-size: 15px;
                }
                LineEdit {
                    placeholder-text: root.t.session-name;
                    text <=> root.new-session-name;
                }
                inbound := CheckBox {
                    text: root.t.inbound;
                }

                Button {
                    text: root.t.gen-keys;
                    clicked => {
                        root.session-gen-keys();
                    }
                }
                Text {
                    text: root.t.my-keys-label;
                    color: gray;
                }
                TextEdit {
                    min-height: 54px;
                    wrap: word-wrap;
                    read-only: true;
                    text: root.my-keys;
                }

                Text {
                    text: root.t.peer-keys-label;
                    color: gray;
                }
                TextEdit {
                    min-height: 54px;
                    wrap: word-wrap;
                    text <=> root.peer-keys-input;
                }

                if inbound.checked: VerticalLayout {
                    spacing: 6px;
                    Text {
                        text: root.t.first-msg-label;
                        color: gray;
                    }
                    TextEdit {
                        min-height: 54px;
                        wrap: word-wrap;
                        text <=> root.first-msg-input;
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Button {
                        text: root.t.create-session;
                        enabled: root.new-session-name != "" && root.peer-keys-input != "" && (!inbound.checked || root.first-msg-input != "");
                        clicked => {
                            root.session-create(root.new-session-name, inbound.checked, root.peer-keys-input, root.first-msg-input);
                        }
                    }
                    Button {
                        text: root.t.close;
                        clicked => {
                            root.creating-session = false;
                        }
                    }
                }

                if root.init-message != "": VerticalLayout {
                    spacing: 6px;
                    Text {
                        text: root.t.init-msg-label;
                        color: gray;
                    }
                    TextEdit {
                        min-height: 54px;
                        wrap: word-wrap;
                        read-only: true;
                        text: root.init-message;
                    }
                }

                StatusLine {
                    message: root.status-text;
                    is-error: root.status-is-error;
                }
                Rectangle {
                    vertical-stretch: 1;
                }
            }

            //------ Normal chat------
            if !root.creating-session: VerticalLayout {
                spacing: 12px;
                padding: 12px;

                // ---- Chat history section ----
                VerticalLayout {
                    spacing: 8px;
                    Text {
                        text: root.t.history;
                        color: #aaa;
                        font-size: 12px;
                        font-weight: 3;
                    }
                    list := Rectangle {
                        background: #1e1e1e;
                        border-radius: 6px;
                        clip: true;

                        ListView {
                            min-height: 200px;
                            property <int> msg-count: root.message-count;
                            changed msg-count => {
                                self.viewport-y = min(0px, self.height - self.viewport-height);
                            }

                            for line in root.messages: Rectangle {
                                height: row.preferred-height + 40px;
                                background: transparent;

                                VerticalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    padding-top: 12px;
                                    padding-bottom: 12px;
                                    spacing: 4px;

                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text {
                                            text: line.sender;
                                            font-weight: 3;
                                            color: (line.sender == root.current-user) ? #64b5f6 : #e0e0e0;
                                            font-size: 11px;
                                        }
                                        Rectangle {}
                                        Text {
                                            text: line.time;
                                            color: #666;
                                            font-size: 10px;
                                        }
                                    }
                                    msg-bubble := Rectangle {
                                        background: (line.sender == root.current-user) ? #095c9f : #2a2a2a;
                                        border-radius: 6px;

                                        VerticalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            padding-top: 6px;
                                            padding-bottom: 6px;

                                            row := TextInput {
                                                width: 100%;
                                                text: line.text;
                                                wrap: word-wrap;
                                                color: #e0e0e0;
                                                read-only: true;
                                                single-line: false;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // ---- Input section ----
                VerticalLayout {
                    spacing: 8px;
                    LineEdit {
                        placeholder-text: root.t.message-placeholder;
                        text <=> root.message-input;
                        accepted => {
                            root.submit-input(self.text);
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Button {
                            text: root.t.encrypt;
                            enabled: root.message-input != "";
                            clicked => {
                                root.do-encrypt(root.message-input);
                            }
                        }
                        Button {
                            text: root.t.decrypt;
                            enabled: root.message-input != "";
                            clicked => {
                                root.do-decrypt(root.message-input);
                            }
                        }
                        Button {
                            text: root.t.paste;
                            clicked => {
                                root.paste-input();
                            }
                        }
                    }
                }

                // ---- Output section ----
                VerticalLayout {
                    spacing: 8px;
                    Text {
                        text: root.t.outgoing-label;
                        color: #aaa;
                        font-size: 12px;
                        font-weight: 3;
                    }
                    TextEdit {
                        min-height: 80px;
                        wrap: word-wrap;
                        read-only: true;
                        text: root.output-text;
                    }
                    Button {
                        text: root.t.copy;
                        enabled: root.output-text != "";
                        clicked => {
                            root.copy-output();
                        }
                    }
                }

                StatusLine {
                    message: root.status-text;
                    is-error: root.status-is-error;
                }
            }
        }
    }
}
