    session-name: string,
    inbound: string,
    gen-keys: string,
    my-keys-label: string,
    peer-keys-label: string,
    first-msg-label: string,
    create-session: string,
    close: string,
    init-msg-label: string,
    history: string,
    message-placeholder: string,
    encrypt: string,
    decrypt: string,
    paste: string,
    outgoing-label: string,
    copy: string,
    previous: string,
    next: string,
    ready_to_create: string,
}
